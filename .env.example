# Skopiuj ten plik jako .env i zastąp wszystkie wartości przed uruchomieniem kontenerów.
DB_ROOT_PASSWORD=UZUPELNIJ_LOSOWYM_HASLEM_ROOT
DB_USER=schoolmusic
DB_PASSWORD=UZUPELNIJ_LOSOWYM_HASLEM_BAZY
REDIS_PASSWORD=UZUPELNIJ_LOSOWYM_HASLEM_REDIS
JWT_KEY=UZUPELNIJ_LOSOWYM_KLUCZEM_MINIMUM_32_BAJTY
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Logowanie e-mailem oraz odzyskiwanie hasła (SMTP na produkcji).
AUTH_EMAIL_LOGIN_ENABLED=true
AUTH_PUBLIC_BASE_URL=http://localhost:8080
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Wyjście audio LibVLC w kontenerze Docker ("dummy" bez fizycznego głośnika lub "alsa"/"pulse").
AUDIO_LIBVLC_OUTPUT=dummy

# Integracja Spotify jest opcjonalna.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/api/spotify-playback/callback
SPOTIFY_DEVICE_NAME=PA Spotify
SPOTIFY_TOKEN_ENCRYPTION_KEY=
