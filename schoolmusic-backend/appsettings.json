{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionString": {
    "database": "DATABASE_CONNECTION_STRING_HERE",
    "redis": "REDIS_CONNECTION_STRING_HERE"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:8080",
      "http://127.0.0.1:8080",
      "http://127.0.0.1:4040"
    ]
  },
  "Features": {
    "SwaggerEnabled": false
  },
  "Auth": {
    "AllowLocalRegistration": false,
    "EmailLoginEnabled": true,
    "PasswordResetTokenMinutes": 15,
    "EmailVerificationTokenMinutes": 1440,
    "PublicBaseUrl": "http://localhost:8080",
    "PasswordResetUrlTemplate": "{baseUrl}/reset-password?token={token}",
    "EmailVerificationUrlTemplate": "{baseUrl}/verify-email?token={token}",
    "MobilePasswordResetUrlTemplate": "",
    "MobileEmailVerificationUrlTemplate": ""
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "SchoolMusic"
  },
  "RateLimiting": {
    "AuthLoginPermitLimit": 15,
    "AuthLoginWindowSeconds": 60,
    "AuthRecoveryPermitLimit": 5,
    "AuthRecoveryWindowMinutes": 15
  },
  "Audio": {
    "LibVlcOutput": ""
  },
  "Voting": {
    "AllowVotingOutsideSchedule": false
  },
  "Scheduler": {
    "Enabled": true
  },
  "School": {
    "TimeZone": "Europe/Warsaw"
  },
  "Jwt": {
    "Issuer": "SchoolMusicAPI",
    "Audience": "SchoolMusicApp",
    "Key": "",
    "ExpirationHours": 12,
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 14
  },
  "Ldap": {
    "Enabled": true,
    "Server": "ldap.szkola.edu.pl",
    "Port": 389,
    "UseSsl": false,
    "Domain": "szkola.edu.pl",
    "SearchBase": "DC=szkola,DC=edu,DC=pl",
    "UserSearchFilter": "(|(sAMAccountName={0})(userPrincipalName={0})(mail={0}))",
    "RequiredGroup": "",
    "PasswordResetUrl": "",
    "PasswordResetGuidance": "Hasło do konta szkolnego (LDAP / Active Directory) resetuje się u szkolnego dostawcy tożsamości lub u administratora IT szkoły.",
    "SimulatedMode": false,
    "SimulatedUsers": []
  }
}
