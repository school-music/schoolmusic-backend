{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionString": {
    "database": "DATABASE_CONNECTION_STRING_HERE",
    "redis":  "REDIS_CONNECTION_STRING_HERE"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ]
  },
  "Features": {
    "SwaggerEnabled": true
  },
  "Jwt": {
    "Issuer": "SchoolMusicAPI",
    "Audience": "SchoolMusicApp",
    "Key": "YOUR_SECRET_KEY_HERE"
  },
  "Ldap": {
    "Enabled": true,
    "Server": "ldap.szkola.edu.pl",
    "Port": 389,
    "UseSsl": false,
    "Domain": "szkola.edu.pl",
    "SearchBase": "DC=szkola,DC=edu,DC=pl",
    "UserSearchFilter": "(|(sAMAccountName={0})(userPrincipalName={0})(mail={0}))",
    "RequiredGroup": "",
    "SimulatedMode": false,
    "SimulatedUsers": []
  }
}
